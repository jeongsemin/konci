# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Naver Developers > Application > Search API (Local search). Server only.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=


# Naver Cloud Platform > CLOVA OCR (Receipt domain). Optional: when unset,
# every receipt goes to the manual approval queue.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# Only for scripts/import-hira.ts (run from your own machine, not needed by the deployed site).
# data.go.kr > HIRA hospital list API key; the detail key falls back to it when unset.
HIRA_SERVICE_KEY=
HIRA_DETAIL_SERVICE_KEY=

# Public origin of the deployed site. Used for canonical/hreflang URLs and the sitemap
# (not for OAuth, which uses the browser's current origin). Set it to your domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact address shown in the terms and privacy policy
NEXT_PUBLIC_CONTACT_EMAIL=
