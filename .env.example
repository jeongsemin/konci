# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Naver local search, used to add clinics the HIRA data doesn't have yet. Optional. Server only.
# New keys: Naver Cloud Platform > NAVER API HUB (Client ID / Client Secret of an Application with Search).
# Old Naver Developers Center keys: also set NAVER_SEARCH_API=legacy (works until 2027-06-30).
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SEARCH_API=


# Naver Cloud Platform > CLOVA OCR (Receipt domain). Optional: when unset,
# every receipt goes to the manual approval queue.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# Receipt emails (Resend, resend.com). Optional. Server only.
# ALERT_EMAIL_TO: administrators told when a receipt is waiting (at most one mail an hour; commas for several).
# ALERT_EMAIL_FROM: sender on a domain verified in Resend, e.g. KONCI <alert@konci.kr>. Without it mail can only
# go to the address the Resend account signed up with, so members get their approve/reject mail only once it is set.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Secret for the daily receipt clean-up that Vercel Cron calls (vercel.json). Any long random string.
CRON_SECRET=

# Only for scripts/import-hira.ts (run from your own machine, not needed by the deployed site).
# data.go.kr > HIRA hospital list API key; the detail key falls back to it when unset.
HIRA_SERVICE_KEY=
HIRA_DETAIL_SERVICE_KEY=

# Public origin of the deployed site. Used for canonical/hreflang URLs and the sitemap
# (not for OAuth, which uses the browser's current origin). Set it to your domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact address shown in the terms and privacy policy
NEXT_PUBLIC_CONTACT_EMAIL=
